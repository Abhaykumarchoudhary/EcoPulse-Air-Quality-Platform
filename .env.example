# EcoPulse API & Data Credentials Template
# Copy this file to .env and fill in your keys

# 1. WAQI / AQICN API Token (Free instant signup at: https://aqicn.org/data-platform/token/)
# Gives live real-time PM2.5 readings for all 40+ Delhi CPCB/DPCC monitoring stations
WAQI_API_TOKEN=your_waqi_api_token_here

# 2. NASA FIRMS MAP Key (Free instant signup at: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Gives real-time satellite fire hotspots (VIIRS/MODIS) across Punjab, Haryana, and NCR
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# 3. OpenAQ API Key (Free signup at: https://explore.openaq.org/register)
# Gives programmatic access to global and Indian government air quality data
OPENAQ_API_KEY=your_openaq_api_key_here

# 4. Open Government Data India (data.gov.in)
# Central Pollution Control Board (CPCB) statutory ambient air quality resource
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# 5. TomTom Traffic API Key (Free 2,500 daily requests at: https://developer.tomtom.com/)
# Gives real-time traffic flow speed, congestion delay, and arterial chokepoints in Delhi
TOMTOM_API_KEY=your_tomtom_api_key_here

# 6. NASA Earthdata Login (Optional, for downloading raw MODIS MAIAC 1 km AOD files)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
